# Локально достаточно PGlite: отдельный сервер PostgreSQL не нужен.
DATABASE_URL=pglite://./.data/postgres
APP_URL=http://localhost:3000

# Обязательно замените разными случайными значениями длиной минимум 32 символа.
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
POSTBACK_SECRET=

# Docker Compose заменяет DATABASE_URL на PostgreSQL по закрытой сети.
# Используйте hex-пароль, чтобы не требовалось URL-кодирование в DATABASE_URL.
POSTGRES_PASSWORD=
CADDY_DOMAIN=example.ru
CADDY_EMAIL=admin@example.ru

# Reverse proxy: true только за доверенным Caddy, без открытого порта приложения.
TRUST_PROXY=false

# Срок хранения подробных событий задаётся в админке (по умолчанию 90 дней).
# Журнал административных действий и история ссылок хранятся отдельно.
AUDIT_RETENTION_DAYS=365
# Период фонового запуска db:retention (секунды), по умолчанию раз в сутки.
MAINTENANCE_INTERVAL_SECONDS=86400

# Необязательная сторонняя аналитика: пустое значение = выключена.
# Скрипт Метрики должен подключаться только после согласия посетителя.
# false (по умолчанию): нет баннера, аналитических cookies и загрузки Метрики.
# Даже заполненный YANDEX_METRIKA_ID сам по себе не включает эти механизмы.
OPTIONAL_ANALYTICS_ENABLED=false
YANDEX_METRIKA_ID=

# Только для CLI admin:create в автоматизированной среде; не оставляйте здесь пароль.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
